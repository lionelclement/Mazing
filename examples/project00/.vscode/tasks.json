{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile Java",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "mkdir -p out && /opt/homebrew/opt/openjdk@23/bin/javac -d out -cp '../../mazing/lib/mazing.jar' src/main/java/**/*.java"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
