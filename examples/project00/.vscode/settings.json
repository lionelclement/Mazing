{
    // Pas d'import automatique de Gradle
    "java.import.gradle.enabled": false,
    
    // Pas d'import automatique de Maven si tu veux le gérer manuellement
    "java.import.maven.enabled": false,

    // Désactiver la mise à jour automatique de la configuration de build
    "java.configuration.updateBuildConfiguration": "disabled",

    // Facultatif : désactiver les tâches Gradle dans le terminal intégré
    "gradle.enabled": false,
    "java.project.sourcePaths": [
        "src/main/java"
    ]
}
